# Where this fleet's coordinators live. Copy to site.env (gitignored) and fill in; the
# scripts read it, and an env var set on the command line still wins.
COORD=${COORD:-http://coordinator.lan:8700}           # primary, LAN address
COORD_TAILNET=${COORD_TAILNET:-http://100.x.y.z:8700}  # primary, tailnet (Mac launchd runners)
STANDBY=${STANDBY:-http://100.x.y.w:8700}              # standby coordinator
COORDS=${COORDS:-$COORD,$STANDBY}                      # what nodes dial: primary, standby
T450S=${T450S:-"100.x.y.a 100.x.y.b"}                  # USB nodes deploy.sh pushes to
